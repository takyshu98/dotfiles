{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/secrets/**)",
      "Read(//**/*key*.pem)",
      "Read(//**/privkey*.pem)",
      "Read(//**/id_rsa*)",
      "Read(//**/.netrc)",
      "Read(//**/.npmrc)",
      "Read(//**/credentials.json)",
      "Read(//**/credentials)",
      "Read(//**/gh/hosts.yml)",
      "Read(//**/.docker/config.json)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/secrets/**)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/.netrc)",
      "Edit(//**/credentials.json)",
      "Edit(//**/credentials)",
      "Edit(//**/gh/hosts.yml)",
      "Edit(//**/.docker/config.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo edit --visibility:*)",
      "Bash(rm -rf:*)",
      "Bash(ssh:*)",
      "Bash(sudo:*)",
      "Bash(security:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git branch -D:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh pr:*)",
      "Bash(gh secret:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(mise use:*)",
      "Bash(npm install:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm publish:*)",
      "Bash(bun add:*)",
      "Bash(bun publish:*)",
      "Bash(pip install:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo install:*)",
      "Bash(aws:*)",
      "Bash(cdk:*)",
      "Bash(docker push:*)",
      "Bash(rm:*)",
      "mcp__chrome-devtools"
    ],
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "Write",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "mcp__context7",
      "mcp__linear-server"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": [
      "~/src",
      "~/share/dotfiles",
      "~/.claude",
      "~/.agents",
      "~/.cache",
      "~/.local",
      "~/.docker",
      "~/.npm",
      "~/.gradle"
    ]
  },
  "model": "sonnet",
  "enabledMcpjsonServers": [
    "linear-server",
    "context7",
    "playwright",
    "chrome-devtools"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/takyshu98/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|LSP|Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/restrict-directories.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx ccusage@latest statusline"
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "codex@openai-codex": true,
    "example-skills@anthropic-agent-skills": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "~/.config/herdr/herdr.sock"
      ],
      "strictAllowlist": true
    },
    "filesystem": {
      "allowWrite": [
        "~/src",
        "~/share/dotfiles",
        "~/.claude",
        "~/.agents",
        "~/.cache",
        "~/.local",
        "~/.docker",
        "~/.npm",
        "~/.gradle",
        "~/.claude.json",
        "~/.mcp.json"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "~/src",
        "~/share/dotfiles",
        "~/.claude",
        "~/.agents",
        "~/.cache",
        "~/.local",
        "~/.docker",
        "~/.npm",
        "~/.gradle",
        "~/.claude.json",
        "~/.mcp.json"
      ]
    },
    "excludedCommands": [
      "node \"*/codex-companion.mjs\" *"
    ]
  },
  "plansDirectory": "./plans",
  "agentPushNotifEnabled": true
}
