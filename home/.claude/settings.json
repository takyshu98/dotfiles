{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "/Users/takyshu98/share/dotfiles/home/.claude/mods/gh-token-keychain",
    "DOCKER_CONTEXT": "orbstack"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "Write",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "mcp__context7",
      "mcp__linear-server"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/.dev.vars)",
      "Read(//**/.dev.vars.*)",
      "Read(//**/.npmrc)",
      "Read(//**/secrets/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.jks)",
      "Read(//**/*.keystore)",
      "Read(//**/*.p8)",
      "Read(~/.ssh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.local/state/.zsh_history)",
      "Read(~/.local/share/uv/credentials/**)",
      "Read(~/.config/uv/uv.toml)",
      "Read(~/.docker/config.json)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/.wrangler/config)",
      "Edit(//**/.env)",
      "Edit(//**/.env.*)",
      "Edit(//**/.dev.vars)",
      "Edit(//**/.dev.vars.*)",
      "Edit(//**/.npmrc)",
      "Edit(//**/secrets/**)",
      "Edit(//**/*.pem)",
      "Edit(//**/*.key)",
      "Edit(//**/*.p12)",
      "Edit(//**/*.pfx)",
      "Edit(//**/*.jks)",
      "Edit(//**/*.keystore)",
      "Edit(//**/*.p8)",
      "Edit(~/.ssh/**)",
      "Edit(~/.netrc)",
      "Edit(~/.git-credentials)",
      "Edit(~/.local/state/.zsh_history)",
      "Edit(~/.local/share/uv/credentials/**)",
      "Edit(~/.config/uv/uv.toml)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.aws/credentials)",
      "Edit(~/.config/.wrangler/config)",
      "Edit(~/.config/gh/hosts.yml)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo edit --visibility:*)",
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(npm login:*)",
      "Bash(npm token:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm login:*)",
      "Bash(pnpm publish:*)",
      "Bash(uv auth:*)",
      "Bash(uv publish:*)",
      "Bash(docker login:*)",
      "Bash(docker push:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(ssh:*)",
      "Bash(security:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git branch -D:*)",
      "Bash(gh api:*)",
      "Bash(gh auth:*)",
      "Bash(gh pr:*)",
      "Bash(gh secret:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(mise use:*)",
      "Bash(aws:*)",
      "Bash(cdk:*)",
      "Bash(rm:*)",
      "mcp__chrome-devtools"
    ],
    "blockReadsOutsideWorkingDirectories": true,
    "additionalDirectories": [
      "~/src",
      "~/share/dotfiles",
      "~/.config",
      "~/.claude",
      "~/.agents",
      "~/.cache",
      "~/.local",
      "~/.docker",
      "~/.npm",
      "~/.gradle"
    ]
  },
  "model": "haiku",
  "enabledMcpjsonServers": [
    "linear-server",
    "context7",
    "playwright",
    "chrome-devtools"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/takyshu98/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|LSP|Read|Write|Edit|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/restrict-directories.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx ccusage@latest statusline"
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true,
    "codex@openai-codex": true,
    "example-skills@anthropic-agent-skills": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "services.gradle.org",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "api.cloudflare.com"
      ],
      "strictAllowlist": true,
      "allowUnixSockets": [
        "~/.config/herdr/herdr.sock",
        "~/.orbstack/run/docker.sock"
      ],
      "allowLocalBinding": true,
      "tlsTerminate": {}
    },
    "filesystem": {
      "allowWrite": [
        "~/src",
        "~/share/dotfiles",
        "~/.config",
        "~/.claude",
        "~/.agents",
        "~/.cache",
        "~/.local",
        "~/.docker",
        "~/.npm",
        "~/.gradle",
        "~/.claude.json",
        "~/.mcp.json"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "~/src",
        "~/share/dotfiles",
        "~/.config",
        "~/.claude",
        "~/.agents",
        "~/.cache",
        "~/.local",
        "~/.docker",
        "~/.npm",
        "~/.gradle",
        "~/.claude.json",
        "~/.mcp.json"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.docker/config.json",
          "mode": "deny"
        },
        {
          "path": "~/.config/.wrangler/config",
          "mode": "deny"
        },
        {
          "path": "~/.local/state/.zsh_history",
          "mode": "deny"
        },
        {
          "path": "~/.local/share/uv/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.config/uv/uv.toml",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "mask",
          "injectHosts": [
            "api.github.com"
          ]
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "UV_PUBLISH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "UV_PUBLISH_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "UV_CREDENTIALS_DIR",
          "mode": "deny"
        },
        {
          "name": "CLOUDFLARE_API_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "node \"*/codex-companion.mjs\" *"
    ]
  },
  "plansDirectory": "./plans",
  "agentPushNotifEnabled": true
}
