{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  }, 
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": true,
    "expo@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "language": "japanese",
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Read",
      "WebFetch",
      "Write",
      "mcp__context7",
      "mcp__chrome-devtools",
      "mcp__plugin_expo_expo"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo edit --visibility:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh pr:*)",
      "Bash(npm install:*)",
      "Bash(aws:*)",
      "Bash(cdk:*)",
      "Bash(docker push:*)",
      "Bash(rm:*)"
    ] 
  },
  "plansDirectory": "./plans",
  "statusLine": {
    "type": "command",
    "command": "npx ccusage@latest statusline"
  }
}
